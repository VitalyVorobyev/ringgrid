  "rtv3d_benchmark": {
    "script": ".venv/bin/python tools/run_rtv3d_eval.py",
    "output": "tools/out/rtv3d_eval/report.json",
    "requires": "data/rtv3d_0",
    "description": "Real-world rtv3d dataset (private, local only): 19 strip images, 2 on the eval's skip list (target_0, target_7), so 17 usable strips x 6 cameras = 102 tiles. Strategy A is the primary regression target (narrow scale prior, most robust to radii subsampling); B (default prior) and D (per-strip best prior) are gated too. Thresholds are ~1.7% below the measured totals (A 4576, B 3913, D 2867), the slack the A gate has always had. Strategy C (8-220 px single pass) detects nothing on both finalize paths: the proposal stage yields 1-4 proposals once the max diameter exceeds ~110 px.",
    "strategies": {
      "A_old_default_20_56": {
