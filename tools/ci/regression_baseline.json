    "script": "tools/run_reference_benchmark.sh",
    "output": "tools/out/reference_benchmark_post_pipeline/summary.json",
    "modes": {
      "none__none": {
        "min_precision": 1.0,
        "min_recall": 1.0,
        "max_center_mean_px": 0.104,
        "max_h_vs_gt_mean_px": 0.064
      },
      "projective_center__none": {
        "min_precision": 1.0,
        "min_recall": 1.0,
        "max_center_mean_px": 0.084,
        "max_h_vs_gt_mean_px": 0.047
      }
    }
  },
